# Fallback notification popups. The island stops this unit at session start and
# owns org.freedesktop.Notifications itself; this one only matters when the
# island is not running.
#
# ExecStartPost holds the unit "starting" until it owns the bus name.

[Unit]
Description=Quickshell notification popups
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
# niri's environment {} block only reaches the processes niri itself spawns, not
# the systemd user manager, so the shared `common` QML module has to be pointed at
# here too. Keep this in step with niri/modules/environment.kdl.
Environment=QML2_IMPORT_PATH=%h/.config/quickshell
ExecStart=/usr/bin/qs -c notifications
# Hold the unit "starting" until the bus name is ours, up to ten seconds.
ExecStartPost=/bin/sh -c 'n=0; while [ $n -lt 100 ]; do busctl --user status org.freedesktop.Notifications >/dev/null 2>&1 && exit 0; n=$((n+1)); sleep 0.1; done; exit 1'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
