[Unit]
Description=Google Clicker automation bot
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
WorkingDirectory=/home/nova/projects/google_clicker
ExecStart=/home/nova/projects/google_clicker/run_forever.sh
Restart=on-failure
RestartSec=30
Environment=DISPLAY=:0
Environment=PATH=/home/nova/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NUM_WORKERS=2

# Allow graceful shutdown (Ctrl+C equivalent)
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=120

# Logging (visible via: journalctl --user -u google-clicker -f)
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
