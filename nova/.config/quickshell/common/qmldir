# Shared module for every menu daemon. Reached as `import common`, which needs
# QML2_IMPORT_PATH=~/.config/quickshell — set in niri's modules/environment.kdl.
#
# Colors.qml is generated by scripts/theme.sh; everything else here is
# hand-written. Tokens/Anim/StateLayer and the Styled* types are ported from
# caelestia-shell (see the header comment in each file).
module common

singleton Colors 1.0 Colors.qml
singleton Tokens 1.0 Tokens.qml

Anim 1.0 Anim.qml
CAnim 1.0 CAnim.qml
StateLayer 1.0 StateLayer.qml
StyledRect 1.0 StyledRect.qml
StyledScrollBar 1.0 StyledScrollBar.qml
StyledTextField 1.0 StyledTextField.qml
