;; ── Variables ────────────────────────────────────────────────────────────────

;; Password manager state
(defvar pm-tab "passwords")
(defvar pm-search "")
(defvar pm-expanded "")

;; Poll password list (re-polls when pm-search changes)
(defpoll pm-entries :interval "5s"
  `~/.config/eww/scripts/pass-list.sh '${pm-search}'`)

;; Poll TOTP list every second
(defpoll totp-entries :interval "1s"
  `~/.config/eww/scripts/totp-list.sh`)

;; ── Password Manager Widgets ─────────────────────────────────────────────────

;; Tab bar
(defwidget pm-tabs []
  (box :class "tab-bar" :orientation "h" :space-evenly false
    (button :class "tab ${pm-tab == 'passwords' ? 'active' : ''}"
            :onclick "eww update pm-tab=passwords"
            "󰌋 Passwords")
    (button :class "tab ${pm-tab == 'totp' ? 'active' : ''}"
            :onclick "eww update pm-tab=totp"
            "󰯄 TOTP")
    (button :class "tab ${pm-tab == 'add' ? 'active' : ''}"
            :onclick "eww update pm-tab=add"
            "+ Add")))

;; Single password entry row
(defwidget pm-entry [domain user has_otp icon entry]
  (box :orientation "v"
    (box :class "entry-row" :orientation "h" :space-evenly false :spacing 8
      (label :class "entry-icon" :text icon)
      (box :orientation "v" :hexpand true
        (label :class "entry-domain" :halign "start" :text domain)
        (label :class "entry-user" :halign "start" :text user))
      (box :space-evenly false :spacing 6
        (label :class "otp-badge"
               :visible has_otp
               :text "● OTP")
        (button :class "action-btn"
                :onclick "eww update pm-expanded='${entry == pm-expanded ? "" : entry}'"
                "⋯"))
      (eventbox :onclick "~/.config/eww/scripts/pass-action.sh copy '${entry}' &"
                :cursor "pointer"
                (box)))
    ;; Action row (visible when this entry is expanded)
    (revealer :reveal {pm-expanded == entry}
              :transition "slidedown"
              :duration "150ms"
      (box :class "action-row" :orientation "h" :spacing 6 :halign "center"
        (button :class "action-button"
                :onclick "~/.config/eww/scripts/pass-action.sh copy-user '${entry}' &"
                " User")
        (button :class "action-button"
                :onclick "~/.config/eww/scripts/pass-action.sh autotype '${entry}' &"
                " Type")
        (button :class "action-button"
                :onclick "~/.config/eww/scripts/pass-action.sh edit '${entry}' &"
                " Edit")
        (button :class "action-button delete"
                :onclick "~/.config/eww/scripts/pass-action.sh delete '${entry}' && eww update pm-search='${pm-search}' &"
                " Del")))))

;; Password list tab
(defwidget pm-password-tab []
  (box :orientation "v"
    (input :class "search-input"
           :onchange "eww update pm-search='{}'"
           :value pm-search
           :placeholder "🔍 Search passwords...")
    (scroll :class "entry-list" :vscroll true :hscroll false
      (box :orientation "v" :spacing 2
        (for e in pm-entries
          (pm-entry :domain {e.domain}
                    :user {e.user}
                    :has_otp {e.has_otp}
                    :icon {e.icon}
                    :entry {e.entry}))))))

;; Single TOTP card
(defwidget totp-card [name code remaining period icon entry]
  (eventbox :onclick "~/.config/eww/scripts/pass-action.sh copy-otp '${entry}' &"
            :cursor "pointer"
    (box :class "totp-card" :orientation "v"
      (label :class "totp-service" :halign "start" :text "${icon} ${name}")
      (label :class "totp-code" :halign "start"
             :style "color: ${remaining > 15 ? '#9ece6a' : remaining > 5 ? '#e0af68' : '#f7768e'};"
             :text "${substring(code, 0, 3)} ${substring(code, 3, 6)}")
      (box :class "totp-progress"
        (box :class "totp-progress-bar"
             :hexpand false
             :style "min-width: ${round(remaining * 100 / period, 0)}%; background-color: ${remaining > 15 ? '#9ece6a' : remaining > 5 ? '#e0af68' : '#f7768e'};"
             "")))))

;; TOTP grid tab
(defwidget pm-totp-tab []
  (scroll :class "totp-grid" :vscroll true :hscroll false
    (box :orientation "v" :spacing 8
      (for e in totp-entries
        (totp-card :name {e.name}
                   :code {e.code}
                   :remaining {e.remaining}
                   :period {e.period}
                   :icon {e.icon}
                   :entry {e.entry})))))

;; Add tab
(defwidget pm-add-tab []
  (box :orientation "h" :spacing 12 :halign "center" :valign "center"
       :style "min-height: 300px;"
    (button :class "add-button"
            :onclick "eww close passmanager && ~/.dotfiles/scripts/rofi/passrofi.sh &"
      (box :orientation "v" :space-evenly false :spacing 8
        (label :class "add-icon" :text "󰌋")
        (label :text "+ Password")))
    (button :class "add-button"
            :onclick "eww close passmanager && bash -c '~/.dotfiles/scripts/rofi/passrofi.sh' &"
      (box :orientation "v" :space-evenly false :spacing 8
        (label :class "add-icon" :text "󰯄")
        (label :text "+ TOTP")))))

;; Main password manager container
(defwidget passmanager-widget []
  (box :class "widget-window" :orientation "v"
    (pm-tabs)
    (box :visible {pm-tab == "passwords"} (pm-password-tab))
    (box :visible {pm-tab == "totp"} (pm-totp-tab))
    (box :visible {pm-tab == "add"} (pm-add-tab))
    (label :class "hint-bar" :text "Click entry to copy password  |  ⋯ for more actions")))

;; ── Windows ──────────────────────────────────────────────────────────────────

(defwindow passmanager
  :monitor 0
  :geometry (geometry :width "600px" :height "520px" :anchor "center")
  :stacking "overlay"
  :focusable true
  :namespace "eww-passmanager"
  (passmanager-widget))
