# Shell Configuration
shell-integration = zsh
term = kitty

# Font Settings
font-family = JetBrainsMono Nerd Font
font-size = 12
font-style = Regular
font-style-bold = SemiBold

# Theme and Appearance
# theme = yourumi-abbys
# theme = Adventure
# theme = Rose Pine
# theme = Catppuccin Mocha
# theme = TokyoNight Night
background-opacity = 0.8
background-blur = true

# Deep Space Theme Override
background = 06060c
foreground = e6e6fa

# Cosmic Palette Overrides (Mocha-based hues adjusted for space)
palette = 0=#181825
palette = 1=#F38BA8
palette = 2=#A6E3A1
palette = 3=#F9E2AF
palette = 4=#89B4FA
palette = 5=#CBA6F7
palette = 6=#89DCEB
palette = 7=#BAC2DE
palette = 8=#313244
palette = 9=#F38BA8
palette = 10=#A6E3A1
palette = 11=#F9E2AF
palette = 12=#89B4FA
palette = 13=#F5C2E7
palette = 14=#94E2D5
palette = 15=#A6ADC8

# Window Settings
window-padding-x = 5
window-decoration = none
window-save-state = always

# GTK Settings
gtk-titlebar = false
gtk-tabs-location = hidden
adw-toolbar-style = flat

# Behavior
confirm-close-surface = false
mouse-hide-while-typing = true

# Keybindings
# Config Management
keybind = ctrl+a>r=reload_config

# Window/Surface Management
keybind = ctrl+a>x=close_surface

# Split Creation
keybind = ctrl+a>h=new_split:left
keybind = ctrl+a>j=new_split:down
keybind = ctrl+a>k=new_split:up
keybind = ctrl+a>l=new_split:right
keybind = ctrl+a>f=toggle_split_zoom

# Split Navigation
keybind = ctrl+a>ctrl+h=goto_split:left
keybind = ctrl+a>ctrl+j=goto_split:bottom
keybind = ctrl+a>ctrl+k=goto_split:top
keybind = ctrl+a>ctrl+l=goto_split:right

# Scrolling
keybind = ctrl+a>g=scroll_to_top
keybind = ctrl+a>G=scroll_to_bottom

# Terminal Control
# keybind = ctrl+l=clear_screen
