[Default Applications]
# Browser — zen
x-scheme-handler/http=zen.desktop
x-scheme-handler/https=zen.desktop
x-scheme-handler/about=zen.desktop
x-scheme-handler/unknown=zen.desktop
text/html=zen.desktop
application/xhtml+xml=zen.desktop

# Documents — zathura (PDFs open in Emacs, below)
application/epub+zip=org.pwmt.zathura.desktop
application/postscript=org.pwmt.zathura.desktop

# Images — imv
image/png=imv-dir.desktop
image/jpeg=imv-dir.desktop
image/webp=imv-dir.desktop
image/gif=imv-dir.desktop
image/bmp=imv-dir.desktop
image/tiff=imv-dir.desktop
image/avif=imv-dir.desktop
image/heif=imv-dir.desktop
image/svg+xml=imv-dir.desktop

# Media — mpv
video/mp4=mpv.desktop
video/webm=mpv.desktop
video/x-matroska=mpv.desktop
video/quicktime=mpv.desktop
video/x-msvideo=mpv.desktop
video/mpeg=mpv.desktop
audio/mpeg=mpv.desktop
audio/x-wav=mpv.desktop
audio/flac=mpv.desktop
audio/ogg=mpv.desktop
audio/opus=mpv.desktop
audio/mp4=mpv.desktop
audio/aac=mpv.desktop

# Prose, notes and data views — Emacs (markdown-mode, pdf-tools, csv-mode)
text/plain=emacsclient.desktop
text/markdown=emacsclient.desktop
text/x-org=emacsclient.desktop
text/x-readme=emacsclient.desktop
text/x-log=emacsclient.desktop
text/english=emacsclient.desktop
text/csv=emacsclient.desktop
text/tab-separated-values=emacsclient.desktop
application/pdf=emacsclient.desktop

# Everything else text-shaped (code, config) — Emacs too
text/css=emacsclient.desktop
text/xml=emacsclient.desktop
text/javascript=emacsclient.desktop
