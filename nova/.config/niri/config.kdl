// ───────────────────────────────────────────────────────────────────────────────────────────
// INPUT CONFIGURATION
// ───────────────────────────────────────────────────────────────────────────────────────────
input {
    keyboard {
        xkb {

        }
    }
    touchpad {
        tap
        dwt
        natural-scroll
    }
    mouse {
 // off
        //natural-scroll

    }
    warp-mouse-to-focus
    focus-follows-mouse max-scroll-amount="40%"
}
// ───────────────────────────────────────────────────────────────────────────────────────────
// DISPLAY CONFIGURATION
// ───────────────────────────────────────────────────────────────────────────────────────────
output "eDP-1" {
    // off
    mode "1920x1080@60"
    scale 1
    position x=0 y=0
}
// ───────────────────────────────────────────────────────────────────────────────────────────
// VISUAL SETTINGS & LAYOUT
// ───────────────────────────────────────────────────────────────────────────────────────────
layout {
    gaps 10
    // center-focused-column "always"
    always-center-single-column
    preset-column-widths {
        proportion 0.5
        proportion 0.75
        proportion 0.33333
    }
    default-column-width {
        proportion 0.5
    }
    // Focus ring styling
    focus-ring {
        width 2
        inactive-color "#505050"
        active-gradient from="green" to="violet" angle=45
    }
    // Window border styling
    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }
    shadow {

    }
    struts {

    }
}


animations {
    window-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    window-close {
        duration-ms 200
        curve "ease-out-cubic"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }
}
prefer-no-csd
// ───────────────────────────────────────────────────────────────────────────────────────────
// WINDOW RULES
// ───────────────────────────────────────────────────────────────────────────────────────────
// General window rules
window-rule {
    default-column-width {
        proportion 0.75
    }
    open-focused true
}
window-rule {
    geometry-corner-radius 5
    clip-to-geometry true
}
// Specific window rules
window-rule {
    match app-id="scrcpy"
    open-floating true
}
window-rule {
    match app-id="satty"
    open-floating true
}
window-rule {
    match app-id="com.mitchellh.ghostty"
    draw-border-with-background false
}
window-rule {
    match app-id="Zoom Workplace"
    draw-border-with-background false
}
window-rule {
    match app-id="zoom"
    draw-border-with-background false
}
window-rule {
    match title="as_toolbar"
    draw-border-with-background false
    block-out-from "screencast"
}
window-rule {
    match title="WasIstLos"
    draw-border-with-background false
    block-out-from "screencast"
}
window-rule {
    match app-id="zenity"
    open-floating true
}
window-rule {
    match app-id=r"ibus.*"
    open-floating true
    draw-border-with-background false
    open-focused false
    default-column-width { fixed 200; }
    default-window-height { fixed 300; }
}
window-rule {
    match app-id="claude-gui"
    open-floating true
    draw-border-with-background false
    open-focused true
    focus-ring {
        off
    }
}
// window-rule {
//     background-effect {
//         blur true
//     }
// }

// ───────────────────────────────────────────────────────────────────────────────────────────
// ENVIRONMENT VARIABLES
// ───────────────────────────────────────────────────────────────────────────────────────────
environment {
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "xdgdesktopportal"
    WLR_HEADLESS_OUTPUTS "1"
    GTK_IM_MODULE "ibus"
    QT_IM_MODULE "ibus"
    XMODIFIERS "@im=ibus"
    GLFW_IM_MODULE "ibus"
}
// ───────────────────────────────────────────────────────────────────────────────────────────
// STARTUP APPLICATIONS
// ───────────────────────────────────────────────────────────────────────────────────────────
// System services
spawn-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"
// System utilities
spawn-at-startup "swayidle"
spawn-at-startup "ibus-daemon" "-drx"
spawn-at-startup "~/.dotfiles/scripts/wallpaper.sh"
// Background services
spawn-sh-at-startup "emacs --daemon"
spawn-sh-at-startup "kdeconnectd"
spawn-sh-at-startup "blueman-applet"
spawn-sh-at-startup "kdeconnect-indicator"
spawn-sh-at-startup "nm-applet --indicator"
spawn-sh-at-startup "udiskie --tray --notify"
spawn-sh-at-startup "wl-paste --watch cliphist store --max-items 100"
spawn-sh-at-startup "~/.dotfiles/scripts/start_tmux.sh"
spawn-at-startup "sshfs" "nova@novahome:/home/nova" "/home/nova/server" \
    "-o" "reconnect,ServerAliveInterval=15,ServerAliveCountMax=3"
hotkey-overlay {
    skip-at-startup
}
// ───────────────────────────────────────────────────────────────────────────────────────────
// KEYBINDINGS
// ───────────────────────────────────────────────────────────────────────────────────────────
binds {
    // Help
    Mod+Shift+Slash {
        spawn "~/.dotfiles/scripts/keybindings/keybindings.sh"
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ APPLICATIONS                                                                        │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Space hotkey-overlay-title="Open ghostty" {
        spawn "ghostty"
    }
    Mod+Ctrl+Space hotkey-overlay-title="Open tmux sessions" {
        spawn "~/.dotfiles/scripts/rofi/tmux.sh"
    }
    Alt+Space hotkey-overlay-title="Claude GUI" {
        spawn "claude-gui"
    }
    Mod+W hotkey-overlay-title="Qutebrowser" {
        spawn "qutebrowser"
    }
    Mod+Ctrl+W hotkey-overlay-title="Qutebrowser work" {
        spawn-sh "qutebrowser --basedir ~/.config/qutebrowser_work"
    }
    Mod+Return hotkey-overlay-title="Open tmux" {
        spawn-sh "ghostty -e ~/.dotfiles/scripts/start_tmux.sh"
    }
    Mod+D hotkey-overlay-title="Application launcher" {
        spawn-sh "rofi -show drun -theme spotlight"
    }
    Mod+Shift+D hotkey-overlay-title="Application launcher" {
        spawn-sh "~/.dotfiles/scripts/rofi/find.sh"
    }
    Mod+N hotkey-overlay-title="Neovim" {
        spawn-sh "neovide"
    }
    Mod+E hotkey-overlay-title="File manager" {
        spawn-sh "ghostty -e yazi"
    }
    Mod+Ctrl+Shift+W hotkey-overlay-title="Windows" {
        spawn-sh "~/.dotfiles/scripts/windows.sh"
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ UTILITIES & MENUS                                                                   │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+O hotkey-overlay-title="File picker" {
        spawn-sh "~/.dotfiles/scripts/file_picker.sh"
    }
    Mod+Shift+O hotkey-overlay-title="Text extractor" {
        spawn-sh "~/.dotfiles/scripts/ocr_select.sh"
    }
    Mod+B hotkey-overlay-title="Bookmarks" {
        spawn-sh "~/.dotfiles/scripts/rofi/bookmarks.sh"
    }
    Mod+G hotkey-overlay-title="Grammar fix" {
        spawn-sh "~/.dotfiles/scripts/fix_grammar.sh"
    }
    Mod+V hotkey-overlay-title="Voice input toggle" {
        spawn "pkill" "-USR1" "-f" "nova-voice.sh";
    }
    Mod+Shift+N hotkey-overlay-title="Notepad" {
      spawn "dms" "ipc" "call" "notepad" "toggle";  
    }
    Mod+Shift+Space hotkey-overlay-title="Application Launcher" { 
        spawn "dms" "ipc" "call" "spotlight" "toggle"; 
    }
    // Mod+V hotkey-overlay-title="Clipboard" {
    //     spawn-sh "~/.dotfiles/scripts/rofi/clipboard.sh"
    // }
    Mod+V hotkey-overlay-title="Clipboard Manager" { 
        spawn "dms" "ipc" "call" "clipboard" "toggle"; 
    }
    Mod+Shift+X hotkey-overlay-title="Tools" {
        spawn-sh "~/.dotfiles/scripts/rofi/tools.sh"
    }
    Mod+Shift+B hotkey-overlay-title="Toggle waybar" {
        spawn-sh "killall waybar || waybar"
    }
    Mod+Ctrl+P hotkey-overlay-title="Phone mirror" {
        spawn-sh "scrcpy --max-fps 60 -Sw"
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ SCREENSHOTS                                                                         │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Shift+S {
        spawn-sh "grim -g \"$(slurp)\" - | satty -f - --copy-command 'wl-copy'"
    }
    Print {
        screenshot
    }
    Ctrl+Print {
        screenshot-screen
    }
    Alt+Print {
        screenshot-window
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ SCREEN RECORDING                                                                    │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Ctrl+R hotkey-overlay-title="Record screen / Stop" {
        spawn-sh "~/.dotfiles/scripts/record-script.sh"
    }
    Mod+Ctrl+Shift+R hotkey-overlay-title="Record region / Stop" {
        spawn-sh "~/.dotfiles/scripts/record-script.sh --region"
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ SYSTEM CONTROLS                                                                     │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Shift+L hotkey-overlay-title="Lock" {
        spawn-sh " dms ipc call lock lock "
    }
    Mod+Shift+E hotkey-overlay-title="Power menu" {
        spawn-sh "~/.dotfiles/scripts/rofi/power.sh"
    }
    // Mod+T        { toggle-column-tabbed-display; }
    Alt+Tab repeat=false {
        toggle-overview
    }
    Mod+Q repeat=false {
        close-window
    }
    Mod+Escape allow-inhibiting=false {
        toggle-keyboard-shortcuts-inhibit
    }
    Ctrl+Alt+Delete {
        quit
    }
    Mod+Ctrl+Shift+P hotkey-overlay-title="Turn off monitor" {
        power-off-monitors
    }
    XF86PowerOff allow-when-locked=true {
        spawn "systemctl suspend-then-hibernate"
    }
    Mod+I hotkey-overlay-title="Toggle idle" {
        spawn-sh "~/.dotfiles/scripts/idle.sh"
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ MEDIA KEYS                                                                          │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    // Volume controls
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "dms ipc call audio increment 5"
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "dms ipc call audio decrement 5"
    }
    XF86AudioMute allow-when-locked=true {
        spawn-sh "dms ipc call audio mute"
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn-sh "swayosd-client --input-volume mute-toggle"
    }
    Num_Lock {
        spawn-sh "sleep 0.3 && swayosd-client --num-lock"
    }
    // Brightness controls
    XF86MonBrightnessUp allow-when-locked=true {
        spawn-sh "~/.dotfiles/scripts/brightness.sh up"
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn-sh "~/.dotfiles/scripts/brightness.sh down"
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ NAVIGATION - COLUMNS                                                                │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Left {
        focus-column-left
    }
    Mod+Right {
        focus-column-right
    }
    Mod+L {
        focus-column-right
    }
    Mod+H {
        focus-column-left
    }
    Mod+Ctrl+Left {
        move-column-left
    }
    Mod+Ctrl+Right {
        move-column-right
    }
    Mod+Ctrl+H {
        move-column-left
    }
    Mod+Ctrl+L {
        move-column-right
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ NAVIGATION - WINDOWS                                                                │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Ctrl+Down {
        move-window-down
    }
    Mod+Ctrl+Up {
        move-window-up
    }
    Mod+Ctrl+J {
        move-window-down
    }
    Mod+Ctrl+K {
        move-window-up
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ NAVIGATION - MONITORS                                                               │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Shift+Left {
        focus-monitor-left
    }
    Mod+Shift+Right {
        focus-monitor-right
    }
    Mod+Shift+Ctrl+Left {
        move-column-to-monitor-left
    }
    Mod+Shift+Ctrl+Down {
        move-column-to-monitor-down
    }
    Mod+Shift+Ctrl+Up {
        move-column-to-monitor-up
    }
    Mod+Shift+Ctrl+Right {
        move-column-to-monitor-right
    }
    Mod+Shift+Ctrl+H {
        move-column-to-monitor-left
    }
    Mod+Shift+Ctrl+J {
        move-column-to-monitor-down
    }
    Mod+Shift+Ctrl+K {
        move-column-to-monitor-up
    }
    Mod+Shift+Ctrl+L {
        move-column-to-monitor-right
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ NAVIGATION - WORKSPACES                                                             │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Down {
        focus-workspace-down
    }
    Mod+J {
        focus-workspace-down
    }
    Mod+Up {
        focus-workspace-up
    }
    Mod+K {
        focus-workspace-up
    }
    Mod+Page_Down {
        focus-workspace-down
    }
    Mod+Page_Up {
        focus-workspace-up
    }
    Mod+Tab hotkey-overlay-title="Window switcher" {
        spawn-sh "~/.dotfiles/scripts/rofi/windows.sh"
    }
    Mod+Ctrl+Page_Down {
        move-column-to-workspace-down
    }
    Mod+Ctrl+Page_Up {
        move-column-to-workspace-up
    }
    Mod+Ctrl+U {
        move-column-to-workspace-down
    }
    Mod+Ctrl+I {
        move-column-to-workspace-up
    }
    Mod+Shift+Page_Down {
        move-workspace-down
    }
    Mod+Shift+Page_Up {
        move-workspace-up
    }
    Mod+Shift+U {
        move-workspace-down
    }
    Mod+Shift+I {
        move-workspace-up
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ NAVIGATION - NUMBERED WORKSPACES                                                    │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+1 {
        focus-workspace 1
    }
    Mod+2 {
        focus-workspace 2
    }
    Mod+3 {
        focus-workspace 3
    }
    Mod+4 {
        focus-workspace 4
    }
    Mod+5 {
        focus-workspace 5
    }
    Mod+6 {
        focus-workspace 6
    }
    Mod+7 {
        focus-workspace 7
    }
    Mod+8 {
        focus-workspace 8
    }
    Mod+9 {
        focus-workspace 9
    }
    Mod+Ctrl+1 {
        move-column-to-workspace 1
    }
    Mod+Ctrl+2 {
        move-column-to-workspace 2
    }
    Mod+Ctrl+3 {
        move-column-to-workspace 3
    }
    Mod+Ctrl+4 {
        move-column-to-workspace 4
    }
    Mod+Ctrl+5 {
        move-column-to-workspace 5
    }
    Mod+Ctrl+6 {
        move-column-to-workspace 6
    }
    Mod+Ctrl+7 {
        move-column-to-workspace 7
    }
    Mod+Ctrl+8 {
        move-column-to-workspace 8
    }
    Mod+Ctrl+9 {
        move-column-to-workspace 9
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ MOUSE WHEEL NAVIGATION                                                              │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    // Workspace scrolling
    Mod+WheelScrollDown cooldown-ms=150 {
        focus-column-right
    }
    Mod+WheelScrollUp cooldown-ms=150 {
        focus-column-left
    }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 {
        focus-workspace-down
    }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 {
        focus-workspace-up
    }
    // Column scrolling
    Mod+WheelScrollRight {
        move-column-to-workspace-down
    }
    Mod+WheelScrollLeft {
        move-column-to-workspace-up
    }
    Mod+Ctrl+WheelScrollRight {
        move-column-right
    }
    Mod+Ctrl+WheelScrollLeft {
        move-column-left
    }
    // Horizontal scrolling with Shift
    Mod+Shift+WheelScrollDown {
        focus-column-right
    }
    Mod+Shift+WheelScrollUp {
        focus-column-left
    }
    Mod+Ctrl+Shift+WheelScrollDown {
        move-column-right
    }
    Mod+Ctrl+Shift+WheelScrollUp {
        move-column-left
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ WINDOW MANAGEMENT                                                                   │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    // Window grouping
    Mod+BracketLeft {
        consume-or-expel-window-left
    }
    Mod+BracketRight {
        consume-or-expel-window-right
    }
    Mod+Comma {
        consume-window-into-column
    }
    Mod+Period {
        expel-window-from-column
    }
    // Window sizing
    Mod+R {
        switch-preset-column-width
    }
    Mod+Shift+R {
        switch-preset-window-height
    }
    Mod+Alt+R {
        reset-window-height
    }
    Mod+F {
        maximize-column
    }
    Mod+Shift+F {
        fullscreen-window
    }
    // Column positioning
    Mod+C {
        center-column
    }
    Mod+Ctrl+C {
        center-visible-columns
    }
    // Fine-grained sizing
    Mod+Minus {
        set-column-width "-10%"
    }
    Mod+Equal {
        set-column-width "+10%"
    }
    Mod+Shift+Minus {
        set-window-height "-10%"
    }
    Mod+Shift+Equal {
        set-window-height "+10%"
    }
    // Floating windows
    Mod+Ctrl+F {
        toggle-window-floating
    }
    Mod+Shift+Tab {
        switch-focus-between-floating-and-tiling
    }
}
// ───────────────────────────────────────────────────────────────────────────────────────────
// MISCELLANEOUS SETTINGS
// ───────────────────────────────────────────────────────────────────────────────────────────
screenshot-path "~/Desktop/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
switch-events {
    lid-close {
        spawn "systemctl suspend-then-hibernate"
    }
}
cursor {
    xcursor-theme "Bibata-Modern-Classic"
}
layer-rule {
    match namespace="^$"
    baba-is-float true
}
include "dms/cursor.kdl"


include "dms/windowrules.kdl"
