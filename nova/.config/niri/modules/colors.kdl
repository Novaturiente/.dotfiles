// Tokyo Night — generated by scripts/theme.sh. Do not edit.
// Niri merges `layout` blocks across includes, so this file carries only the
// colours; gaps, column presets and animations stay in modules/layout.kdl.
layout {
    focus-ring {
        width 2
        inactive-color "#292e42"
        active-gradient from="#bb9af7" to="#7dcfff" angle=225
    }
    border {
        off
        width 4
        active-color "#bb9af7"
        inactive-color "#3b4261"
        urgent-color "#f7768e"
    }
}
