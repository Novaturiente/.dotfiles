// ───────────────────────────────────────────────────────────────────────────────────────────
// KEYBINDINGS
// ───────────────────────────────────────────────────────────────────────────────────────────
binds {
    // Help
    Mod+Shift+Slash {
        spawn "~/.dotfiles/scripts/keybindings/keybindings.sh"
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ APPLICATIONS                                                                        │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Space hotkey-overlay-title="Open ghostty" {
        spawn "ghostty"
    }
    Mod+Ctrl+Space hotkey-overlay-title="Open tmux sessions" {
        spawn "~/.dotfiles/scripts/rofi/tmux.sh"
    }
    Mod+W hotkey-overlay-title="Browser" {
        spawn "firefox"
    }
    Mod+Ctrl+W hotkey-overlay-title="Qutebrowser work" {
        spawn-sh "qutebrowser --basedir ~/.config/qutebrowser_work"
    }
    Mod+Shift+W hotkey-overlay-title="Qutebrowser (VPN)" {
        spawn-sh "vpn-run qutebrowser"
    }
    Mod+Return hotkey-overlay-title="Open tmux" {
        // spawn-sh "ghostty -e ~/.dotfiles/scripts/start_tmux.sh"
		spawn-sh "ghostty --title='herdr' -e herdr"
    }
    Mod+D hotkey-overlay-title="Application launcher" {
        spawn-sh "rofi -show drun -theme spotlight"
    }
    // Mod+P hotkey-overlay-title="Phone (calls + SMS)" {
    //     spawn "~/.local/bin/ac-phone"
    // }
    Mod+Shift+D hotkey-overlay-title="File search" {
        spawn "~/.dotfiles/scripts/rofi/tv-edit.sh";
    }
    Mod+N hotkey-overlay-title="Neovim" {
        spawn-sh "ghostty -e nvim"
    }
    Mod+Ctrl+N hotkey-overlay-title="Claude project (lazygit + claude)" {
        spawn-sh "~/.dotfiles/scripts/rofi/projects.sh"
    }
    Mod+E hotkey-overlay-title="File manager" {
        spawn-sh "ghostty -e explorenova"
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ UTILITIES & MENUS                                                                   │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+O hotkey-overlay-title="File picker" {
        spawn-sh "~/.dotfiles/scripts/file_picker.sh"
    }
    Mod+Shift+O hotkey-overlay-title="Text extractor" {
        spawn-sh "~/.dotfiles/scripts/ocr_select.sh"
    }
    // Mod+B hotkey-overlay-title="Bookmarks" {
    //     spawn-sh "~/.dotfiles/scripts/rofi/bookmarks.sh"
    // }
    Mod+S hotkey-overlay-title="Firefox URL bar" {
        spawn-sh "~/.dotfiles/scripts/rofi/firefox-url.sh"
    }
    Mod+G hotkey-overlay-title="Grammar fix" {
        spawn-sh "~/.dotfiles/scripts/fix_grammar.sh"
    }
    Mod+Shift+C hotkey-overlay-title="Calendar" {
        spawn-sh "~/.dotfiles/scripts/rofi/calendar.sh"
    }
    Mod+Shift+N hotkey-overlay-title="Notepad" {
      spawn "dms" "ipc" "call" "notepad" "toggle";
    }
    Mod+V hotkey-overlay-title="Clipboard Manager" {
        spawn "dms" "ipc" "call" "clipboard" "toggle";
    }
    Mod+Shift+X hotkey-overlay-title="Tools" {
        spawn-sh "~/.dotfiles/scripts/rofi/tools.sh"
    }
    Mod+Shift+P hotkey-overlay-title="Password Manager" {
        spawn-sh "~/.dotfiles/scripts/rofi/passrofi.sh"
    }
    Mod+P hotkey-overlay-title="Phone mirror" {
        spawn-sh "scrcpy --max-fps 60 -Sw --turn-screen-off --stay-awake --keep-active --power-off-on-close --window-height=1150"
    }
    Mod+Ctrl+P hotkey-overlay-title="Phone mirror" {
        spawn-sh "scrcpy --max-fps 60 -Sw --turn-screen-off --stay-awake --keep-active --power-off-on-close --new-display=1920x1080 --window-title 'dexmode'"
    }
	Alt+Space {
		spawn-sh "handy --toggle-transcription"
	}
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ SCREENSHOTS                                                                         │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Shift+S {
        spawn-sh "grim -g \"$(slurp)\" - | satty -f - --copy-command 'wl-copy'"
    }
    Print {
        screenshot
    }
    Ctrl+Print {
        screenshot-screen
    }
    Alt+Print {
        screenshot-window
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ SCREEN RECORDING                                                                    │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Ctrl+R hotkey-overlay-title="Record screen / Stop" {
        spawn-sh "~/.dotfiles/scripts/record-script.sh"
    }
    Mod+Ctrl+Shift+R hotkey-overlay-title="Record region / Stop" {
        spawn-sh "~/.dotfiles/scripts/record-script.sh --region"
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ SYSTEM CONTROLS                                                                     │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Shift+L hotkey-overlay-title="Lock" {
        spawn-sh " dms ipc call lock lock "
    }
    Mod+Shift+E hotkey-overlay-title="Power menu" {
        spawn "dms" "ipc" "call" "powermenu" "toggle";
    }
    // Mod+T        { toggle-column-tabbed-display; }
    Alt+Tab repeat=false {
        toggle-overview
    }
    Mod+Q repeat=false {
        close-window
    }
    Mod+BackSpace repeat=false {
        close-window
    }
    Mod+Escape allow-inhibiting=false {
        toggle-keyboard-shortcuts-inhibit
    }
    Ctrl+Alt+Delete {
        quit
    }
    Mod+Ctrl+Shift+P hotkey-overlay-title="Turn off monitor" {
        power-off-monitors
    }
    XF86PowerOff allow-when-locked=true {
        spawn "systemctl suspend-then-hibernate"
    }
    Mod+I hotkey-overlay-title="Toggle idle" {
        spawn-sh "~/.dotfiles/scripts/idle.sh"
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ MEDIA KEYS                                                                          │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    // Volume controls
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "dms ipc call audio increment 5"
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "dms ipc call audio decrement 5"
    }
    // Shift+wheel = brightness
    Shift+XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "~/.dotfiles/scripts/brightness.sh up"
    }
    Shift+XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "~/.dotfiles/scripts/brightness.sh down"
    }
    XF86AudioMute allow-when-locked=true {
        spawn-sh "dms ipc call audio mute"
    }
    // Shift+wheel-press = toggle idle/sleep inhibit (same as Mod+I)
    Shift+XF86AudioMute allow-when-locked=true {
        spawn-sh "~/.dotfiles/scripts/idle.sh"
    }
    XF86AudioMicMute allow-when-locked=true {
        spawn-sh "dms ipc call audio micmute"
    }
    Num_Lock {
        spawn-sh "sleep 0.3 && swayosd-client --num-lock"
    }
    // Brightness controls
    XF86MonBrightnessUp allow-when-locked=true {
        spawn-sh "~/.dotfiles/scripts/brightness.sh up"
    }
    XF86MonBrightnessDown allow-when-locked=true {
        spawn-sh "~/.dotfiles/scripts/brightness.sh down"
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ NAVIGATION - COLUMNS                                                                │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Left {
        focus-column-left
    }
    Mod+Right {
        focus-column-right
    }
    Mod+L {
        focus-column-right
    }
    Mod+H {
        focus-column-left
    }
    Mod+Ctrl+Left {
        move-column-left
    }
    Mod+Ctrl+Right {
        move-column-right
    }
    Mod+Ctrl+H {
        move-column-left
    }
    Mod+Ctrl+L {
        move-column-right
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ NAVIGATION - WINDOWS                                                                │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Ctrl+Down {
        move-window-down
    }
    Mod+Ctrl+Up {
        move-window-up
    }
    Mod+Ctrl+J {
        move-window-down
    }
    Mod+Ctrl+K {
        move-window-up
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ NAVIGATION - MONITORS                                                               │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Shift+Left {
        focus-monitor-left
    }
    Mod+Shift+Right {
        focus-monitor-right
    }
    Mod+Shift+Ctrl+Left {
        move-column-to-monitor-left
    }
    Mod+Shift+Ctrl+Down {
        move-column-to-monitor-down
    }
    Mod+Shift+Ctrl+Up {
        move-column-to-monitor-up
    }
    Mod+Shift+Ctrl+Right {
        move-column-to-monitor-right
    }
    Mod+Shift+Ctrl+H {
        move-column-to-monitor-left
    }
    Mod+Shift+Ctrl+J {
        move-column-to-monitor-down
    }
    Mod+Shift+Ctrl+K {
        move-column-to-monitor-up
    }
    Mod+Shift+Ctrl+L {
        move-column-to-monitor-right
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ NAVIGATION - WORKSPACES                                                             │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+Down {
        focus-workspace-down
    }
    Mod+J {
        focus-workspace-down
    }
    Mod+Up {
        focus-workspace-up
    }
    Mod+K {
        focus-workspace-up
    }
    Mod+Page_Down {
        focus-workspace-down
    }
    Mod+Page_Up {
        focus-workspace-up
    }
    Mod+Tab hotkey-overlay-title="Window switcher" {
        spawn-sh "~/.dotfiles/scripts/rofi/windows.sh"
    }
    Mod+Ctrl+Page_Down {
        move-column-to-workspace-down
    }
    Mod+Ctrl+Page_Up {
        move-column-to-workspace-up
    }
    Mod+Ctrl+U {
        move-column-to-workspace-down
    }
    Mod+Ctrl+I {
        move-column-to-workspace-up
    }
    Mod+Shift+Page_Down {
        move-workspace-down
    }
    Mod+Shift+Page_Up {
        move-workspace-up
    }
    Mod+Shift+U {
        move-workspace-down
    }
    Mod+Shift+I {
        move-workspace-up
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ NAVIGATION - NUMBERED WORKSPACES                                                    │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    Mod+1 {
        focus-workspace 1
    }
    Mod+2 {
        focus-workspace 2
    }
    Mod+3 {
        focus-workspace 3
    }
    Mod+4 {
        focus-workspace 4
    }
    Mod+5 {
        focus-workspace 5
    }
    Mod+6 {
        focus-workspace 6
    }
    Mod+7 {
        focus-workspace 7
    }
    Mod+8 {
        focus-workspace 8
    }
    Mod+9 {
        focus-workspace 9
    }
    Mod+Ctrl+1 {
        move-column-to-workspace 1
    }
    Mod+Ctrl+2 {
        move-column-to-workspace 2
    }
    Mod+Ctrl+3 {
        move-column-to-workspace 3
    }
    Mod+Ctrl+4 {
        move-column-to-workspace 4
    }
    Mod+Ctrl+5 {
        move-column-to-workspace 5
    }
    Mod+Ctrl+6 {
        move-column-to-workspace 6
    }
    Mod+Ctrl+7 {
        move-column-to-workspace 7
    }
    Mod+Ctrl+8 {
        move-column-to-workspace 8
    }
    Mod+Ctrl+9 {
        move-column-to-workspace 9
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ MOUSE WHEEL NAVIGATION                                                              │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    // Workspace scrolling
    Mod+WheelScrollDown cooldown-ms=150 {
        focus-column-right
    }
    Mod+WheelScrollUp cooldown-ms=150 {
        focus-column-left
    }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 {
        focus-workspace-down
    }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 {
        focus-workspace-up
    }
    // Column scrolling
    Mod+WheelScrollRight {
        move-column-to-workspace-down
    }
    Mod+WheelScrollLeft {
        move-column-to-workspace-up
    }
    Mod+Ctrl+WheelScrollRight {
        move-column-right
    }
    Mod+Ctrl+WheelScrollLeft {
        move-column-left
    }
    // Horizontal scrolling with Shift
    Mod+Shift+WheelScrollDown {
        focus-column-right
    }
    Mod+Shift+WheelScrollUp {
        focus-column-left
    }
    Mod+Ctrl+Shift+WheelScrollDown {
        move-column-right
    }
    Mod+Ctrl+Shift+WheelScrollUp {
        move-column-left
    }
    // ┌─────────────────────────────────────────────────────────────────────────────────────┐
    // │ WINDOW MANAGEMENT                                                                   │
    // └─────────────────────────────────────────────────────────────────────────────────────┘
    // Window grouping
    Mod+BracketLeft {
        consume-or-expel-window-left
    }
    Mod+BracketRight {
        consume-or-expel-window-right
    }
    Mod+Comma {
        consume-window-into-column
    }
    Mod+Period {
        expel-window-from-column
    }
    // Window sizing
    Mod+R {
        switch-preset-column-width
    }
    Mod+Shift+R {
        switch-preset-window-height
    }
    Mod+Alt+R {
        reset-window-height
    }
    Mod+F {
        maximize-column
    }
    Mod+Shift+F {
        fullscreen-window
    }
    // Column positioning
    Mod+C {
        center-column
    }
    Mod+Ctrl+C {
        center-visible-columns
    }
    // Fine-grained sizing
    Mod+Minus {
        set-column-width "-10%"
    }
    Mod+Equal {
        set-column-width "+10%"
    }
    Mod+Shift+Minus {
        set-window-height "-10%"
    }
    Mod+Shift+Equal {
        set-window-height "+10%"
    }
    // Floating windows
    Mod+Ctrl+F {
        toggle-window-floating
    }
    Mod+Shift+Tab {
        switch-focus-between-floating-and-tiling
    }
}
