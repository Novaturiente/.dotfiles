// ───────────────────────────────────────────────────────────────────────────────────────────
// WINDOW RULES
// ───────────────────────────────────────────────────────────────────────────────────────────
// General window rules
window-rule {
    default-column-width {
        proportion 0.75
    }
    open-focused true
}
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
}
// Specific window rules
window-rule {
    match app-id="scrcpy"
    open-floating false
    default-column-width {
        fixed 540
    }
    open-on-workspace "Main"
}
window-rule {
    match title="dexmode"
    open-maximized true
    open-on-workspace "Main"
}
window-rule {
    match title="herdr"
    open-maximized true
}
// Screenshot editor
window-rule {
    match app-id="satty"
    open-floating true
    draw-border-with-background false
}
//ghostty terminal
window-rule {
    match app-id="com.mitchellh.ghostty"
    draw-border-with-background false
}
//File selector
window-rule {
    match title="Select File to Attach"
    draw-border-with-background false
    open-floating true
}
window-rule {
    match app-id="firefox"
    draw-border-with-background false
    open-on-workspace "Main"
}
window-rule {
    match app-id="zenity"
    open-floating true
}
// WinApps RemoteApp windows (app-ids all start with "Microsoft "):
// must float — tiling them fights RAIL geometry and dialogs resize-loop
// window-rule {
//     match app-id="^Microsoft"
//     open-floating true
// }
window-rule {
    background-effect {
        blur true
    }
}

// Whatsapp 
window-rule {
    match app-id="FFPWA-01KSERG1J9XQTRJF8C0CMC3MS3"
    block-out-from "screen-capture" 
    open-on-workspace "Main"
}
