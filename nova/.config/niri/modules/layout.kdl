// ───────────────────────────────────────────────────────────────────────────────────────────
// VISUAL SETTINGS & LAYOUT
// ───────────────────────────────────────────────────────────────────────────────────────────
workspace "Main"


layout {
    gaps 10
    // center-focused-column "always"
    always-center-single-column
    preset-column-widths {
        proportion 0.5
        proportion 0.75
        proportion 0.33333
    }
    default-column-width {
        proportion 0.5
    }
    // Focus ring styling
    focus-ring {
        width 2
        inactive-color "#181825"
        active-gradient from="#FF007F" to="#8C52FF" to="#00E5FF" angle=225
    }
    // Window border styling
    border {
        off
        width 4
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }
    shadow {

    }
    struts {

    }
}


animations {
    window-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    window-close {
        duration-ms 200
        curve "ease-out-cubic"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=300 epsilon=0.0001
    }
}
prefer-no-csd
