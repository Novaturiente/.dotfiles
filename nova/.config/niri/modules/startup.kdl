// ───────────────────────────────────────────────────────────────────────────────────────────
// STARTUP APPLICATIONS
// ───────────────────────────────────────────────────────────────────────────────────────────
// System services
// disabled 2026-08-31: DMS ships its own polkit agent (Modals/PolkitAuthModal.qml);
// the GNOME agent registered first and shadowed it with "An authentication agent already exists"
// spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
// System utilities
spawn-at-startup "swayidle"
// Hyprland hides the DMS bar (the island replaces it there) and DMS saves that
// to settings.json, so show it again here once DMS answers. Same for DMS's
// volume/brightness OSD, which Hyprland turns off in favour of the island.
spawn-sh-at-startup "for i in $(seq 50); do dms ipc call bar reveal id default 2>/dev/null | grep -q SUCCESS && break; sleep 0.2; done; dms ipc call settings set osdVolumeEnabled true; dms ipc call settings set osdBrightnessEnabled true"
// Background services
spawn-sh-at-startup "kdeconnectd"
spawn-sh-at-startup "udiskie --no-tray --notify"
spawn-at-startup "sshfs" "nova@novahome:/home/nova" "/home/nova/server" \
    "-o" "reconnect,ServerAliveInterval=15,ServerAliveCountMax=3"
hotkey-overlay {
    skip-at-startup
}
// disabled 2026-06-01: server-side deploy alert system stopped; was spamming "null" notifications from ntfy keepalive events
// spawn-sh-at-startup "~/.dotfiles/scripts/incoming-notification.sh"
//Handy startup
// disabled 2026-09-20: first Alt+Space now boots handy itself (costs one dead keypress + cold start)
// spawn-sh-at-startup "handy --start-hidden"
// Quickshell menus are not started here: each launcher script in scripts/quickshell/
// starts its menu on demand, and the menu quits once it is closed and idle.
