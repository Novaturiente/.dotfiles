// ───────────────────────────────────────────────────────────────────────────────────────────
// STARTUP APPLICATIONS
// ───────────────────────────────────────────────────────────────────────────────────────────
// System services
spawn-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"
// System utilities
spawn-at-startup "swayidle"
spawn-at-startup "ibus-daemon" "-drx"
spawn-at-startup "~/.dotfiles/scripts/wallpaper.sh"
// Background services
spawn-sh-at-startup "emacs --daemon"
spawn-sh-at-startup "kdeconnectd"
spawn-sh-at-startup "blueman-applet"
spawn-sh-at-startup "kdeconnect-indicator"
spawn-sh-at-startup "nm-applet --indicator"
spawn-sh-at-startup "udiskie --tray --notify"
spawn-sh-at-startup "wl-paste --watch cliphist store --max-items 100"
spawn-at-startup "sshfs" "nova@novahome:/home/nova" "/home/nova/server" \
    "-o" "reconnect,ServerAliveInterval=15,ServerAliveCountMax=3"
hotkey-overlay {
    skip-at-startup
}
// disabled 2026-06-01: server-side deploy alert system stopped; was spamming "null" notifications from ntfy keepalive events
// spawn-sh-at-startup "~/.dotfiles/scripts/incoming-notification.sh"
//Handy startup
spawn-sh-at-startup "handy --start-hidden"
// Firefox URL bar menu — resident quickshell daemon, toggled by Mod+S over IPC
spawn-at-startup "qs" "-c" "firefox-url" "-d"
// Password manager menu — resident quickshell daemon, toggled by Mod+Shift+P
spawn-at-startup "qs" "-c" "pass" "-d"
// Calendar menu — resident quickshell daemon, toggled by Mod+Shift+C
spawn-at-startup "qs" "-c" "calendar" "-d"
// Keybindings cheat-sheet — resident quickshell daemon, toggled by Mod+Shift+Slash
spawn-at-startup "qs" "-c" "keybindings" "-d"
// App launcher (drun) — resident quickshell daemon, toggled by Mod+D
spawn-at-startup "qs" "-c" "launcher" "-d"
// Window switcher — resident quickshell daemon, toggled by Mod+Tab
spawn-at-startup "qs" "-c" "switcher" "-d"
// Clipboard manager (image previews) — resident quickshell daemon, toggled by Mod+V
spawn-at-startup "qs" "-c" "clipboard" "-d"
