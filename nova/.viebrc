" Vieb config — mirrors qutebrowser setup (~/.config/qutebrowser/config.py)
" Reload with :source ~/.viebrc or restart Vieb.

" ── Theme / UI ──────────────────────────────────────────────
colorscheme catppuccin-mocha
set nativetheme=dark
set guifontsize=14
set mintabwidth=140

" ── Hints: home-row chars, chip at element corner ───────────
set followchars=custom:asdfghjkl
set followlabelposition=cornertopleft

" ── Page dark mode ──────────────────────────────────────────
" Real force-dark comes from Chromium blink flags in vieb.desktop
" (same algorithm as qutebrowser). darkreader stays off to avoid
" double-darkening; <Space>td toggles it manually if ever needed.
set darkreader=false
set darkreaderbg=#1e1e2e
set darkreaderfg=#cdd6f4

" ── Search engine + keywords (qutebrowser url.searchengines) ─
set searchengine=https://search.novarch.site/search?q=%s
set searchwords=g~https://www.google.com/search?q=%s,gh~https://github.com/search?q=%s,aw~https://wiki.archlinux.org/index.php?search=%s,yt~https://www.youtube.com/results?search_query=%s

" ── Start page ──────────────────────────────────────────────
set startuppages=https://search.novarch.site

" ── Downloads ───────────────────────────────────────────────
set downloadpath=~/Downloads

" ── Permissions: ask like qutebrowser ───────────────────────
set permissionnotifications=ask
set permissionmicrophone=ask
set permissioncamera=ask
set permissiondisplaycapture=ask

" ── External browser (qutebrowser Ctrl+Alt+t → thorium) ─────
set externalcommand=thorium-browser-avx2

" ── Keybindings: qutebrowser muscle memory ──────────────────
" o/O open url in current/new tab
nmap o <toExploreMode>
nmap O <:tabnew><toExploreMode>
" Alt+hjkl / Alt+arrows tab switching
nmap <A-h> <previousTab>
nmap <A-l> <nextTab>
nmap <A-k> <previousTab>
nmap <A-j> <nextTab>
nmap <A-Left> <previousTab>
nmap <A-Right> <nextTab>
" Ctrl-p ≈ qutebrowser passthrough (insert mode sends keys to page)
nmap <C-p> <toInsertMode>
" leave insert with Alt+Backspace (Esc / Ctrl-[ already work)
imap <A-BS> <toNormalMode>
" devtools
nmap <F12> <:devtools>
" Space leader toggles
nmap <Space>td <:set darkreader!>
