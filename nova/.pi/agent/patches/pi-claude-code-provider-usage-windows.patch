+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { homedir } from "node:os";
+
+// LOCAL PATCH (nova): keep the per-response usage windows (5h / 7d utilization + reset) that
+// Claude sends as rate_limit_event, for pi's claude-usage footer and usage-panel. Upstream drops them.
+function persistUnifiedWindows(info: unknown): void {
+  const windows = (info as { unifiedWindows?: unknown } | null)?.unifiedWindows;
+  if (!windows || typeof windows !== "object") return;
+  try {
+    const dir = `${homedir()}/.cache`;
+    const file = `${dir}/claude-usage-live.json`;
+    let prev: { windows?: object } = {};
+    try {
+      prev = JSON.parse(readFileSync(file, "utf8"));
+    } catch {
+      prev = {}; // first write
+    }
+    mkdirSync(dir, { recursive: true });
+    writeFileSync(file, JSON.stringify({ at: Date.now(), windows: { ...prev.windows, ...windows } }));
+  } catch {
+    // advisory; must never fail a provider request
+  }
+}
 
