{
  "lastChangelogVersion": "0.99.2",
  "theme": "dark",
  "defaultProvider": "pi-claude-code-provider",
  "defaultModel": "opus",
  "packages": [
    "git:github.com/chem/pi-claude-code-provider",
    "npm:pi-subagents",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-powerline-footer",
    "npm:pi-caveman",
    "npm:pi-impeccable-skill",
    "npm:@narumitw/pi-plan-mode",
    {
      "source": "npm:@juicesharp/rpiv-ask-user-question",
      "extensions": []
    },
    "npm:@rokiy/pi-ui",
    "npm:pi-rewind",
    "npm:@narumitw/pi-btw",
    "npm:@everyx/pi-read-doc",
    "npm:@narumitw/pi-goal",
    {
      "source": "npm:@juicesharp/rpiv-todo",
      "extensions": []
    },
    "npm:pi-background-tasks",
    "npm:pi-simplify",
    "npm:pi-agent-browser-native",
    "npm:@vndv/pi-codegraph",
    "npm:pi-lens"
  ],
  "extensions": [
    "extensions/compact-tools.ts",
    "extensions/turn-timer.ts",
    "extensions/claude-usage.ts",
    "/home/nova/.pi/agent/npm/node_modules/@juicesharp/rpiv-todo/index.bundle.mjs",
    "/home/nova/.pi/agent/npm/node_modules/@juicesharp/rpiv-ask-user-question/index.bundle.mjs"
  ],
  "powerline": {
    "separator": "pipe",
    "placement": "below",
    "welcome": false,
    "model": {
      "display": "name",
      "showThinkingLevel": true
    },
    "context": {
      "format": "percent"
    },
    "cache_read": {
      "format": "percent"
    },
    "layout": {
      "left": [
        "custom:wtpath",
        "git",
        "model",
        "shell_mode",
        "queue",
        "custom:ctx",
        "cache_read",
        "cost",
        "custom:usage",
        "extension_statuses",
        "time_spent",
        "custom:turn",
        "custom:bg"
      ],
      "secondary": []
    },
    "customItems": [
      {
        "id": "ctx",
        "statusKey": "ctx",
        "position": "left",
        "selfColorize": true
      },
      {
        "id": "usage",
        "statusKey": "usage",
        "position": "left",
        "selfColorize": true
      },
      {
        "id": "turn",
        "statusKey": "turn",
        "position": "left",
        "selfColorize": true
      },
      {
        "id": "bg",
        "statusKey": "background-tasks",
        "position": "left"
      },
      {
        "id": "wtpath",
        "statusKey": "wtpath",
        "position": "left",
        "color": "#00afaf"
      }
    ]
  },
  "quietStartup": true,
  "showLastPrompt": false,
  "tuiMode": "fullscreen",
  "hideThinkingBlock": true,
  "doubleEscapeAction": "none",
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "pi-claude-code-provider/haiku"
      }
    }
  }
}