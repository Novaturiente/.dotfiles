#!/usr/bin/env bash
# coolify-api — thin curl wrapper for Coolify v4 REST API
# Usage:
#   coolify-api <METHOD> <PATH> [curl args...]
#   coolify-api GET /applications
#   coolify-api POST "/deploy?uuid=abc123"
#   coolify-api POST /applications/abc/envs -d '{"key":"FOO","value":"bar"}'
#
# Config sources (priority high→low):
#   env already set: COOLIFY_URL, COOLIFY_API_TOKEN or COOLIFY_API_KEY
#   file: ~/.config/coolify/config
#   file: ~/.env (sourced for COOLIFY_* vars only)
set -euo pipefail

CONFIG_FILE="${COOLIFY_CONFIG:-$HOME/.config/coolify/config}"

if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  set -a; source "$CONFIG_FILE"; set +a
fi

# Fallback: pull COOLIFY_* lines from ~/.env without sourcing other secrets
if [[ -z "${COOLIFY_API_TOKEN:-}${COOLIFY_API_KEY:-}" && -f "$HOME/.env" ]]; then
  while IFS= read -r line; do
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ "$line" =~ ^[[:space:]]*$ ]] && continue
    if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?(COOLIFY_[A-Z_]+)=(.*)$ ]]; then
      key="${BASH_REMATCH[2]}"
      val="${BASH_REMATCH[3]}"
      val="${val%\"}"; val="${val#\"}"
      val="${val%\'}"; val="${val#\'}"
      export "$key=$val"
    fi
  done < "$HOME/.env"
fi

# Accept either COOLIFY_API_TOKEN or COOLIFY_API_KEY
: "${COOLIFY_API_TOKEN:=${COOLIFY_API_KEY:-}}"
: "${COOLIFY_URL:=https://coolify.eecglobal.com}"

if [[ -z "${COOLIFY_API_TOKEN:-}" ]]; then
  echo "ERROR: COOLIFY_API_TOKEN/COOLIFY_API_KEY not set. Add to ~/.env, $CONFIG_FILE, or export." >&2
  exit 2
fi

if [[ $# -lt 2 ]]; then
  echo "usage: coolify-api <METHOD> <PATH> [curl args...]" >&2
  exit 2
fi

METHOD="$1"; shift
ENDPOINT="$1"; shift

# Strip trailing slash from URL, ensure leading slash on endpoint
URL="${COOLIFY_URL%/}"
[[ "$ENDPOINT" != /* ]] && ENDPOINT="/$ENDPOINT"
# Allow callers to pass /api/v1/foo OR /foo
[[ "$ENDPOINT" != /api/* ]] && ENDPOINT="/api/v1${ENDPOINT}"

FULL="${URL}${ENDPOINT}"

# Build curl call. -sS quiet but show errors. --fail-with-body returns body on 4xx/5xx.
RESPONSE=$(curl -sS --fail-with-body \
  -X "$METHOD" \
  -H "Authorization: Bearer ${COOLIFY_API_TOKEN}" \
  -H "Accept: application/json" \
  -H "Content-Type: application/json" \
  "$@" \
  "$FULL") || {
    EC=$?
    echo "ERROR: curl exit $EC for $METHOD $FULL" >&2
    [[ -n "${RESPONSE:-}" ]] && echo "$RESPONSE" >&2
    exit $EC
  }

# Pretty-print JSON if jq present and response is JSON
if command -v jq >/dev/null 2>&1 && [[ -n "$RESPONSE" ]]; then
  if echo "$RESPONSE" | jq -e . >/dev/null 2>&1; then
    echo "$RESPONSE" | jq .
    exit 0
  fi
fi
echo "$RESPONSE"
