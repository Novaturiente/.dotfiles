{
  "mcpServers": {
    "codegraph": {
      "command": "codegraph",
      "args": ["serve", "--mcp"],
      "shared": true
    },
    "serena": {
      "command": "serena",
      "args": ["start-mcp-server", "--context=agent", "--project-from-cwd"],
      "shared": false
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.0.3"],
      "shared": true
    },
    "gsc": {
      "command": "searchconsole-mcp",
      "args": [],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/home/nova/.secrets/gsc-service-account.json"
      },
      "shared": true
    }
  }
}
