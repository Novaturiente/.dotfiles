/* Keybindings — palette comes from the active theme.
   Wider window, more lines, slight transparency */

@import "~/.config/rofi/current.rasi"

* {
    font:   "JetBrainsMono Nerd Font Mono 12";


    background-color:   transparent;
    text-color:         @text;
    accent-color:       @blue;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    background-color:   @bg0;        /* base, slight transparency */
    border-color:       @overlay0;

    location:   north;
    anchor:     south;
    y-offset:   50px;
    width:      760px;
    border:     0px;
    padding:    3px 5px;
}

inputbar {
    padding:    5px 10px;
    spacing:    12px;
    children:   [ prompt, entry ];
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}

prompt {
    text-color: @blue;
}

listview {
    lines:      20;
    columns:    1;
    fixed-height:   false;
}

element {
    padding:    8px;
    spacing:    8px;
}

element normal urgent {
    text-color: @red;
}

element normal active {
    text-color: @blue;
}

element alternate active {
    text-color: @sapphire;
}

element selected {
    text-color: @crust;
}

element selected normal {
    background-color:   @blue;
}

element selected urgent {
    background-color:   @peach;
}

element selected active {
    background-color:   @mauve;
}

element-icon {
    size:   0.75em;
}

element-text {
    text-color: inherit;
}
