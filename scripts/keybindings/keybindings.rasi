/* Keybindings — Catppuccin Mocha
   Wider window, more lines, slight transparency */

* {
    font:   "JetBrainsMono Nerd Font Mono 12";

    rosewater:   #f5e0dc;
    flamingo:    #f2cdcd;
    pink:        #f5c2e7;
    mauve:       #cba6f7;
    red:         #f38ba8;
    maroon:      #eba0ac;
    peach:       #fab387;
    yellow:      #f9e2af;
    green:       #a6e3a1;
    teal:        #94e2d5;
    sky:         #89dceb;
    sapphire:    #74c7ec;
    blue:        #89b4fa;
    lavender:    #b4befe;
    text:        #cdd6f4;
    subtext1:    #bac2de;
    subtext0:    #a6adc8;
    overlay2:    #9399b2;
    overlay1:    #7f849c;
    overlay0:    #6c7086;
    surface2:    #585b70;
    surface1:    #45475a;
    surface0:    #313244;
    base:        #1e1e2e;
    mantle:      #181825;
    crust:       #11111b;

    background-color:   transparent;
    text-color:         @text;
    accent-color:       @blue;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    background-color:   #1e1e2eE6;   /* base, slight transparency */
    border-color:       @overlay0;

    location:   north;
    anchor:     south;
    y-offset:   50px;
    width:      760px;
    border:     0px;
    padding:    3px 5px;
}

inputbar {
    padding:    5px 10px;
    spacing:    12px;
    children:   [ prompt, entry ];
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}

prompt {
    text-color: @blue;
}

listview {
    lines:      20;
    columns:    1;
    fixed-height:   false;
}

element {
    padding:    8px;
    spacing:    8px;
}

element normal urgent {
    text-color: @red;
}

element normal active {
    text-color: @blue;
}

element alternate active {
    text-color: @sapphire;
}

element selected {
    text-color: @crust;
}

element selected normal {
    background-color:   @blue;
}

element selected urgent {
    background-color:   @peach;
}

element selected active {
    background-color:   @mauve;
}

element-icon {
    size:   0.75em;
}

element-text {
    text-color: inherit;
}
