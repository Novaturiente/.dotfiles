# Maintainer: Novaturiente <Novaturiente@proton.me>
#
# Upstream ships no Arch package; this repackages the official prebuilt
# standalone release. Not in the AUR, so paru cannot resolve the name and it is
# deliberately absent from system/package/*.yaml -- same as novarch itself.

pkgname=omamail-bin
_pkgname=omamail
pkgver=0.10.5
pkgrel=2
# The vendored Qt. The shell-integration plugins below must match it exactly:
# Qt refuses to load a plugin built against a newer Qt than the host binary.
_qtver=6.8.3
pkgdesc='Keyboard-first mail and calendar client for Gmail, HEY, JMAP and IMAP (standalone Qt build)'
arch=('x86_64')
url='https://github.com/huacnlee/omamail'
license=('MIT')
# ponytail: the bundle carries its own Qt 6, Wayland, EGL and GL libraries, so
# ldd resolves everything but the toolchain runtime inside /opt/omamail. Add a
# dependency here only if ldd starts pointing outside the bundle.
depends=('glibc' 'gcc-libs')
optdepends=('gnome-keyring: org.freedesktop.secrets provider, required to store account credentials')
provides=("$_pkgname")
conflicts=("$_pkgname")
# Prebuilt binaries: stripping the vendored Qt libraries breaks them.
options=('!strip')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/omamail-app-linux-x86_64.tar.gz"
        "LICENSE-$pkgver::https://raw.githubusercontent.com/huacnlee/omamail/v$pkgver/LICENSE"
        "qt6-wayland-$_qtver.pkg.tar.zst::https://archive.archlinux.org/packages/q/qt6-wayland/qt6-wayland-$_qtver-1-x86_64.pkg.tar.zst")
sha256sums=('085989067509efab0c60f43f1a99c6917d4cc2fd93c67b7394e409a82b371235'
            '74bdc41f1dac37231bd32e6eec60a167a5877dc324299db89d5b6c0e4d32f339'
            '4dff684bc9a6431c1195d4830848e812d1de1aaf2f3045244ed9f42d00e355eb')

package() {
	# qt.conf sets Prefix=.. relative to bin/, so the tree must stay intact.
	install -dm755 "$pkgdir/opt"
	cp -a "$srcdir/omamail.app" "$pkgdir/opt/$_pkgname"

	# The release bundles the Wayland platform plugin but not the shell
	# integration it loads at startup, so Qt aborts with "No shell integration
	# named xdg-shell found". These come from the Arch build of the same Qt.
	# They need no rpath patch: libQt6WaylandClient is already in the process
	# by the time the platform plugin dlopens them.
	cp -a "$srcdir/usr/lib/qt6/plugins/wayland-shell-integration" \
		"$pkgdir/opt/$_pkgname/plugins/"

	install -Dm755 /dev/stdin "$pkgdir/usr/bin/$_pkgname" <<-'EOF'
		#!/bin/sh
		# ponytail: two upstream gaps, both overridable from the environment so a
		# fixed release needs no wrapper change. The bundle has no xcb-free default
		# platform, and its vendored libEGL cannot reach Mesa ("EGL not available"),
		# which leaves Qt Quick no GL context -- hence the software scene graph.
		export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"
		export QT_QUICK_BACKEND="${QT_QUICK_BACKEND:-software}"
		exec /opt/omamail/bin/omamail-app "$@"
	EOF

	# The shipped entry already uses bare Exec=omamail and Icon=omamail, which
	# resolve through PATH and hicolor once installed system-wide.
	install -Dm644 "$srcdir/omamail.app/share/applications/$_pkgname.desktop" \
		"$pkgdir/usr/share/applications/$_pkgname.desktop"
	install -Dm644 "$srcdir/omamail.app/share/icons/hicolor/scalable/apps/$_pkgname.svg" \
		"$pkgdir/usr/share/icons/hicolor/scalable/apps/$_pkgname.svg"
	install -Dm644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
