# Tokyo Night (Night) — https://github.com/folke/tokyonight.nvim
#
# Mapped onto the Catppuccin-derived token names shared by every palette here;
# see catppuccin.env for why those names are the common vocabulary.
#
# Tokyo Night has no direct equivalent for a few Catppuccin accents. Where that
# happens the nearest upstream Tokyo Night colour is reused and noted, so two
# tokens can legitimately hold the same value.

THEME_NAME="tokyonight"
THEME_LABEL="Tokyo Night"
THEME_DESC="Clean dark theme celebrating the lights of downtown Tokyo at night"
THEME_POLARITY="dark"

# ── Surfaces, darkest to lightest ───────────────────────────────────────────
CRUST="0c0e14"        # bg_dark1
MANTLE="16161e"       # bg_dark
BASE="1a1b26"         # bg
SURFACE0="24283b"     # bg_visual / storm bg
SURFACE1="292e42"     # bg_highlight
SURFACE2="3b4261"     # fg_gutter
OVERLAY0="414868"     # terminal_black
OVERLAY1="565f89"     # comment
OVERLAY2="737aa2"     # dark5

# ── Text ────────────────────────────────────────────────────────────────────
SUBTEXT0="9aa5ce"
SUBTEXT1="a9b1d6"     # fg_dark
TEXT="c0caf5"         # fg

# ── Accents ─────────────────────────────────────────────────────────────────
ROSEWATER="ffc7c7"    # no upstream equivalent; soft rose to pair with red
FLAMINGO="ff9e64"     # orange
PINK="ff007c"         # magenta2
MAUVE="bb9af7"        # magenta
RED="f7768e"          # red
MAROON="db4b4b"       # red1
PEACH="ff9e64"        # orange (same as FLAMINGO upstream)
YELLOW="e0af68"       # yellow
GREEN="9ece6a"        # green
TEAL="73daca"         # green1
SKY="7dcfff"          # cyan
SAPPHIRE="2ac3de"     # blue1
BLUE="7aa2f7"         # blue
LAVENDER="9d7cd8"     # purple

ACCENT="bb9af7"
ACCENT_TEXT="1a1b26"

# ── Niri focus ring ─────────────────────────────────────────────────────────
RING_INACTIVE="292e42"
RING_FROM="bb9af7"
RING_TO="7dcfff"
RING_ANGLE="225"
BORDER_ACTIVE="bb9af7"
BORDER_INACTIVE="3b4261"
BORDER_URGENT="f7768e"
