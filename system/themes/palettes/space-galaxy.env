# Space Galaxy — the look this repo carried before the theme system existed.
#
# Catppuccin Mocha's accents over a near-black base. Ghostty and nvim used to
# hardcode base #06060c and text #e6e6fa inline; those overrides now live here,
# together with the pink/purple/cyan niri focus gradient.

THEME_NAME="space-galaxy"
THEME_LABEL="Space Galaxy"
THEME_DESC="Deep-space black with Catppuccin accents and a nebula focus ring"
THEME_POLARITY="dark"

# ── Surfaces, darkest to lightest ───────────────────────────────────────────
CRUST="000000"
MANTLE="030307"
BASE="06060c"
SURFACE0="12121e"
SURFACE1="1e1e2e"
SURFACE2="2a2a3e"
OVERLAY0="46466a"
OVERLAY1="6a6a8c"
OVERLAY2="8c8caf"

# ── Text ────────────────────────────────────────────────────────────────────
SUBTEXT0="a0a0c0"
SUBTEXT1="c8c8e0"
TEXT="e6e6fa"         # lavender starlight white

# ── Accents ─────────────────────────────────────────────────────────────────
ROSEWATER="f5e0dc"
FLAMINGO="f2cdcd"
PINK="f5c2e7"
MAUVE="cba6f7"
RED="f38ba8"
MAROON="eba0ac"
PEACH="fab387"
YELLOW="f9e2af"
GREEN="a6e3a1"
TEAL="94e2d5"
SKY="89dceb"
SAPPHIRE="74c7ec"
BLUE="89b4fa"
LAVENDER="b4befe"

ACCENT="cba6f7"
ACCENT_TEXT="06060c"

# ── Niri focus ring ─────────────────────────────────────────────────────────
RING_INACTIVE="12121e"
RING_FROM="ff007f"
RING_TO="00e5ff"
RING_ANGLE="225"
BORDER_ACTIVE="ffc87f"
BORDER_INACTIVE="505050"
BORDER_URGENT="9b0000"
