# Catppuccin Mocha — https://github.com/catppuccin/catppuccin
#
# Every palette in this directory MUST define the same variable names; the
# templates in ../templates/ reference nothing else. `theme.sh --check` fails
# if a palette is missing a key.
#
# Values are bare hex WITHOUT a leading '#'. Templates add '#', '0x' or a
# decimal conversion as their format requires.
#
# The token names are Catppuccin's because that is where this palette set
# started and it keeps the diff against the existing configs small. Other
# themes map their own colours onto these names.

THEME_NAME="catppuccin"
THEME_LABEL="Catppuccin Mocha"
THEME_DESC="Soothing pastel theme for the high-spirited"
THEME_POLARITY="dark"

# ── Surfaces, darkest to lightest ───────────────────────────────────────────
CRUST="11111b"
MANTLE="181825"
BASE="1e1e2e"
SURFACE0="313244"
SURFACE1="45475a"
SURFACE2="585b70"
OVERLAY0="6c7086"
OVERLAY1="7f849c"
OVERLAY2="9399b2"

# ── Text ────────────────────────────────────────────────────────────────────
SUBTEXT0="a6adc8"
SUBTEXT1="bac2de"
TEXT="cdd6f4"

# ── Accents ─────────────────────────────────────────────────────────────────
ROSEWATER="f5e0dc"
FLAMINGO="f2cdcd"
PINK="f5c2e7"
MAUVE="cba6f7"
RED="f38ba8"
MAROON="eba0ac"
PEACH="fab387"
YELLOW="f9e2af"
GREEN="a6e3a1"
TEAL="94e2d5"
SKY="89dceb"
SAPPHIRE="74c7ec"
BLUE="89b4fa"
LAVENDER="b4befe"

# The one colour that means "selected/active" across every application.
ACCENT="cba6f7"
# Readable text drawn on top of ACCENT.
ACCENT_TEXT="1e1e2e"

# ── Niri focus ring ─────────────────────────────────────────────────────────
# RING_FROM/VIA/TO drive the active gradient; VIA is the middle stop.
RING_INACTIVE="313244"
RING_FROM="cba6f7"
RING_TO="89b4fa"
RING_ANGLE="225"
BORDER_ACTIVE="cba6f7"
BORDER_INACTIVE="45475a"
BORDER_URGENT="f38ba8"
