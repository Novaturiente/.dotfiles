# Rosé Pine (main) — https://rosepinetheme.com
#
# Mapped onto the Catppuccin-derived token names shared by every palette here;
# see catppuccin.env for why those names are the common vocabulary.
#
# Rosé Pine is a smaller palette than Catppuccin: it has no distinct green,
# sky or lavender, so several tokens deliberately share a value. Where a
# reasonable Rosé Pine colour exists in a sibling variant (Moon, Dawn) it is
# borrowed rather than invented; the two derived greys are noted below.

THEME_NAME="rosepine"
THEME_LABEL="Rosé Pine"
THEME_DESC="All natural pine, faux fur and a bit of soho vibes"
THEME_POLARITY="dark"

# ── Surfaces, darkest to lightest ───────────────────────────────────────────
CRUST="100f1c"        # derived: darker than base, for the deepest wells
MANTLE="14121f"       # derived: between crust and base
BASE="191724"         # base
SURFACE0="1f1d2e"     # surface
SURFACE1="26233a"     # overlay
SURFACE2="403d52"     # highlight_med
OVERLAY0="524f67"     # highlight_high
OVERLAY1="6e6a86"     # muted
OVERLAY2="908caa"     # subtle

# ── Text ────────────────────────────────────────────────────────────────────
SUBTEXT0="a9a5c0"     # derived: between subtle and text
SUBTEXT1="c4c1dc"     # derived: between subtle and text
TEXT="e0def4"         # text

# ── Accents ─────────────────────────────────────────────────────────────────
ROSEWATER="ebbcba"    # rose
FLAMINGO="ebbcba"     # rose (no lighter equivalent upstream)
PINK="eb6f92"         # love
MAUVE="c4a7e7"        # iris
RED="eb6f92"          # love
MAROON="d7827e"       # rose, Dawn variant — a deeper rose
PEACH="f6c177"        # gold
YELLOW="f6c177"       # gold (same as PEACH upstream)
GREEN="31748f"        # pine — Rosé Pine maps ANSI green here, it is blue-teal
TEAL="9ccfd8"         # foam
SKY="9ccfd8"          # foam (same as TEAL upstream)
SAPPHIRE="3e8fb0"     # pine, Moon variant — a brighter pine
BLUE="9ccfd8"         # foam — Rosé Pine maps ANSI blue here
LAVENDER="c4a7e7"     # iris (same as MAUVE upstream)

ACCENT="c4a7e7"
ACCENT_TEXT="191724"

# ── Niri focus ring ─────────────────────────────────────────────────────────
RING_INACTIVE="26233a"
RING_FROM="c4a7e7"
RING_TO="9ccfd8"
RING_ANGLE="225"
BORDER_ACTIVE="c4a7e7"
BORDER_INACTIVE="403d52"
BORDER_URGENT="eb6f92"
