# ${THEME_LABEL} — generated by scripts/theme.sh. Do not edit.
# swaylock-effects — Catppuccin Mocha
# Colours are <rrggbb[aa]>. `swaylock --help` lists every option used here.
#
# Note on layout: swaylock draws the clock, date and typing feedback INSIDE the
# indicator, so they move as one block. indicator-*-position places that block;
# there is no way to split the clock from the password feedback.

# ---- Background ----
# Fallback colour behind the wallpaper (lock.sh passes -i <wallpaper>).
color=${BASE}
# The image itself is passed by scripts/lock.sh (-i <current wallpaper>).
# No blur: the point is to see the wallpaper, not the desktop behind it.
scaling=fill
effect-vignette=0.25:0.5
fade-in=0.25

# ---- Indicator block: near the top, centred (screen is 1920x1200) ----
# y-position is the CENTRE of the indicator, so the smallest usable value is
# roughly indicator-radius; 100 with a radius of 90 leaves ~10px above the ring.
indicator
indicator-idle-visible
indicator-x-position=960
indicator-y-position=100
indicator-radius=90
indicator-thickness=3

# ---- Clock ----
clock
timestr=%H:%M
datestr=%A, %e %B
# Steelfish Outline: the condensed display face in nova/.fonts. Hollow
# letterforms need more size than a solid font to read, hence 48 rather than 26.
font=Steelfish
font-size=48

# ---- No box at rest: transparent inside, invisible ring until you type ----
inside-color=00000000
inside-clear-color=00000000
inside-caps-lock-color=00000000
inside-ver-color=00000000
inside-wrong-color=00000000

ring-color=00000000
ring-clear-color=${GREEN}ff
ring-caps-lock-color=${YELLOW}ff
ring-ver-color=${YELLOW}ff
ring-wrong-color=${RED}ff

line-uses-inside
separator-color=00000000

# ---- Typing feedback ----
key-hl-color=${MAUVE}ff
bs-hl-color=${RED}ff
caps-lock-key-hl-color=${YELLOW}ff
caps-lock-bs-hl-color=${RED}ff

# ---- Text ----
text-color=${TEXT}ff
text-clear-color=${GREEN}ff
text-caps-lock-color=${YELLOW}ff
text-ver-color=${YELLOW}ff
text-wrong-color=${RED}ff

# ---- Keyboard layout box ----
layout-bg-color=${BASE}cc
layout-border-color=${SURFACE1}ff
layout-text-color=${TEXT}ff

# ---- Behaviour ----
show-failed-attempts
daemonize
