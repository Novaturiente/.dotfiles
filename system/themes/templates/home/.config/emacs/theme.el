;;; theme.el --- ${THEME_LABEL} -*- lexical-binding: t; -*-
;; Generated by scripts/theme.sh. Do not edit. Loaded by init.el.
;;
;; ponytail: every theme is painted through catppuccin-theme's palette slots,
;; the same trick as nvim/lua/theme.lua, instead of one Emacs package per theme.
;; The palette is set before the theme file first loads (catppuccin keeps an
;; already-set value), so the theme is loaded exactly once.

