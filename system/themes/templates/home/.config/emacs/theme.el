        (teal      . "#${TEAL}")
        (sky       . "#${SKY}")
        (sapphire  . "#${SAPPHIRE}")
        (blue      . "#${BLUE}")
        (lavender  . "#${LAVENDER}")
        (text      . "#${TEXT}")
        (subtext1  . "#${SUBTEXT1}")
        (subtext0  . "#${SUBTEXT0}")
        (overlay2  . "#${OVERLAY2}")
