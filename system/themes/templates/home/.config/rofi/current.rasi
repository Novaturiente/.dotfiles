/* ${THEME_LABEL} — generated by scripts/theme.sh. Do not edit. */

* {
  rosewater:      #${ROSEWATER};
  flamingo:       #${FLAMINGO};
  pink:           #${PINK};
  mauve:          #${MAUVE};
  red:            #${RED};
  maroon:         #${MAROON};
  peach:          #${PEACH};
  yellow:         #${YELLOW};
  green:          #${GREEN};
  teal:           #${TEAL};
  sky:            #${SKY};
  sapphire:       #${SAPPHIRE};
  blue:           #${BLUE};
  lavender:       #${LAVENDER};
  text:           #${TEXT};
  subtext1:       #${SUBTEXT1};
  subtext0:       #${SUBTEXT0};
  overlay2:       #${OVERLAY2};
  overlay1:       #${OVERLAY1};
  overlay0:       #${OVERLAY0};
  surface2:       #${SURFACE2};
  surface1:       #${SURFACE1};
  surface0:       #${SURFACE0};
  base:           #${BASE};
  mantle:         #${MANTLE};
  crust:          #${CRUST};
  accent:         #${ACCENT};

  /* Translucent surfaces: base at 90%, surface1 at 82%. */
  bg0:            #${BASE}E6;
  bg1:            #${SURFACE1}D0;
}

/* bg - background, fg - foreground, br - border */
* {
  main-bg:        @crust;
  main-fg:        @text;
  main-br:        @overlay2;
  input-bg:       @mantle;
  select-bg:      @overlay2;
  select-fg:      @crust;
}
