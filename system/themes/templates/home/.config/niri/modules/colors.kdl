// ${THEME_LABEL} — generated by scripts/theme.sh. Do not edit.
// Niri merges `layout` blocks across includes, so this file carries only the
// colours; gaps, column presets and animations stay in modules/layout.kdl.
layout {
    focus-ring {
        width 2
        inactive-color "#${RING_INACTIVE}"
        active-gradient from="#${RING_FROM}" to="#${RING_TO}" angle=${RING_ANGLE}
    }
    border {
        off
        width 4
        active-color "#${BORDER_ACTIVE}"
        inactive-color "#${BORDER_INACTIVE}"
        urgent-color "#${BORDER_URGENT}"
    }
}
