__pycache__/
.aider*
temp/

# Password store (sensitive metadata)
nova/.password-store/

# Backup files
*.bak
*.backup*
*.back[0-9]*

# Zen profile — track only user.js, never profile data (cookies, history, keys)
nova/.config/zen/**
!nova/.config/zen/**/
!nova/.config/zen/**/user.js

# GTK: the asset dirs are symlinks into /usr/share/themes/adw-gtk3
nova/.config/gtk-3.0/assets
nova/.config/gtk-4.0/assets
nova/.config/gtk-4.0/servers

# KDE Connect identity: private key and its certificate are per-machine secrets
nova/.config/kdeconnect/privateKey.pem
nova/.config/kdeconnect/certificate.pem

# Shell history: local only, may hold secrets
nova/.config/zsh/.histfile
