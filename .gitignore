__pycache__/
.aider*
temp/

# Password store (sensitive metadata)
nova/.password-store/

# Backup files
*.bak
*.backup*
*.back[0-9]*

# Zen profile — track only user.js, never profile data (cookies, history, keys)
nova/.config/zen/**
!nova/.config/zen/**/
!nova/.config/zen/**/user.js

# GTK: the asset dirs are symlinks into /usr/share/themes/adw-gtk3
nova/.config/gtk-3.0/assets
nova/.config/gtk-4.0/assets
nova/.config/gtk-4.0/servers

# KDE Connect: track only the top-level config; the private key and its
# certificate are per-machine secrets, device dirs are per-machine state
nova/.config/kdeconnect/*
!nova/.config/kdeconnect/config

# winapps: holds the Windows VM password (RDP_PASS), written by scripts/winapps-setup.sh
nova/.config/winapps/winapps.conf

# Shell history: local only, may hold secrets
nova/.config/zsh/.histfile

# Work skills with client infrastructure details: local only (repo is public)
nova/.novacode/skills/eec-infra/
nova/.novacode/skills/coolify/
nova/.novacode/skills/semrush-ops/
